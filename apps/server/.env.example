# Copy to .env and adjust. Must match docker-compose.yml Postgres creds.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/maiscope

# Postgres pool size. Unset locally for the default (4), matching what local
# docker Postgres was hardcoded to before this was configurable. Neon's free
# tier caps total connections low — set this lower in prod.
# DATABASE_MAX_CONNECTIONS=4

# TCP port the API binds. Fly injects this itself; unset it locally to keep
# the default (3000).
# PORT=3000

# Comma-separated exact Origin values allowed to call the API cross-origin
# (e.g. https://maiscope.pages.dev). Unset locally — CORS is permissive in dev.
# CORS_ALLOWED_ORIGINS=

# tracing_subscriber::EnvFilter directive string. Unset locally for the
# default (info,tower_http=info).
# RUST_LOG=
