# Copy to .env and adjust. Must match docker-compose.yml Postgres creds.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/maiscope

# Postgres pool size. Unset locally for the default (4), matching what local
# docker Postgres was hardcoded to before this was configurable. Neon's free
# tier caps total connections low — set this lower in prod.
# DATABASE_MAX_CONNECTIONS=4

# TCP port the API binds. Fly injects this itself; unset it locally to keep
# the default (3000).
# PORT=3000

# Comma-separated exact Origin values allowed to call the API cross-origin.
# No allowlist configured = no origin allowed (fails closed, not permissive) —
# set this explicitly, including for local dev.
CORS_ALLOWED_ORIGINS=http://localhost:1420

# tracing_subscriber::EnvFilter directive string. Unset locally for the
# default (info,tower_http=info).
# RUST_LOG=

# Set to "true" for JSON log output (production/Fly). Unset locally for the
# default (pretty, human-readable).
# LOG_JSON=

# Headers trusted to carry the client IP for rate limiting (ADR-0019). Leave
# unset locally: there is no proxy, the socket address is the client. Fly
# sets this to `fly-client-ip` in fly.toml.
# TRUSTED_IP_HEADERS=

# GitHub OAuth app credentials (server-auth-github-oauth). Create a separate
# OAuth app for local dev at https://github.com/settings/developers; its
# callback URL must equal GITHUB_REDIRECT_URL exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where GitHub sends the browser back after consent: the frontend's callback
# route, which checks `state` and then calls /api/auth/github/callback itself
# (issue 03). Must match the OAuth app's registered callback URL.
GITHUB_REDIRECT_URL=http://localhost:1420/auth/callback

# HS256 signing key for access JWTs, at least 32 bytes; the server refuses to
# start without one. Rotating it invalidates outstanding access tokens only:
# refresh tokens are not signed with it, so clients refresh and carry on.
# Generate: openssl rand -base64 48
JWT_SECRET=
