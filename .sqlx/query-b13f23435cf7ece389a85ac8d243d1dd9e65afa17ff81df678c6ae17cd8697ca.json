  "query": "INSERT INTO users (github_id, login, avatar_url)\n           VALUES ($1, $2, $3)\n           ON CONFLICT (github_id) DO UPDATE\n              SET login = EXCLUDED.login,\n                  avatar_url = EXCLUDED.avatar_url,\n                  deleted_at = NULL,\n                  updated_at = now()\n           RETURNING id, login AS \"login!\", avatar_url, role",
